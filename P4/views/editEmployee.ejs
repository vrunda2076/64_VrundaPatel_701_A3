<h2>Edit Employee</h2>

<form method="POST" action="/update/<%= emp._id %>">
  <input name="name" value="<%= emp.name %>" required />
  <input name="email" value="<%= emp.email %>" required />
  <input name="salary" type="number" value="<%= emp.salary %>" required />
  <input name="role" value="<%= emp.role %>" required />
  <button>Update</button>
</form>