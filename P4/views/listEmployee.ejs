<h2>Employee List</h2>

<table border="1">
<tr>
  <th>EmpID</th>
  <th>Name</th>
  <th>Email</th>
  <th>Salary</th>
  <th>Role</th>
  <th>Actions</th>
</tr>

<% employees.forEach(emp => { %>
<tr>
  <td><%= emp.empId %></td>
  <td><%= emp.name %></td>
  <td><%= emp.email %></td>
  <td><%= emp.salary %></td>
  <td><%= emp.role %></td>
  <td>
    <a href="/edit/<%= emp._id %>">Edit</a>
    <a href="/delete/<%= emp._id %>">Delete</a>
  </td>
</tr>
<% }) %>
</table>